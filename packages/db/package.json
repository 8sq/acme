  "exports": {
    ".": "./src/index.server.ts",
    "./migrate": "./src/migrate.server.ts"
  },
  "dependencies": {
    "@acme/node": "workspace:*",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@acme/workerd": "workspace:*",
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
