{
  "name": "@acme/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "pnpm lint && pnpm test",
    "dev": "pnpm -r --parallel dev",
    "lint": "oxfmt --check . && oxlint --no-error-on-unmatched-pattern .",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
