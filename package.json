{
  "name": "@acme/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "pnpm lint && pnpm test",
    "lint": "oxfmt --check . && oxlint --no-error-on-unmatched-pattern .",
    "test": "vitest run",
    "ygoma:dev": "pnpm --filter @acme/ygoma dev",
    "ygoma:dev:workerd": "pnpm --filter @acme/ygoma dev:workerd"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.0"
}
